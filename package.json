{
  "name": "ai-usage-statusbar-gustavohrg-2026",
  "displayName": "AI Usage Pulse GH 2026",
  "description": "VS Code status bar monitor for Claude, Codex, Copilot, and optional Antigravity usage",
  "icon": "icon.png",
  "version": "1.0.0",
  "publisher": "gustavohrg",
  "author": "Gustavo Henrique",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gustavohrg/ai-usage-statusbar.git"
  },
  "bugs": {
    "url": "https://github.com/gustavohrg/ai-usage-statusbar/issues"
  },
  "homepage": "https://github.com/gustavohrg/ai-usage-statusbar#readme",
  "engines": {
    "vscode": "^1.79.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "ai",
    "usage",
    "statusbar",
    "claude",
    "codex",
    "copilot",
    "antigravity",
    "agy",
    "tokens",
    "monitoring"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "icons": {
      "ai-usage-claude": {
        "description": "Claude provider icon",
        "default": {
          "fontPath": "./assets/fonts/fa-brands-400.woff2",
          "fontCharacter": "\\E861"
        }
      },
      "ai-usage-codex": {
        "description": "Codex provider icon",
        "default": {
          "fontPath": "./assets/fonts/fa-brands-400.woff2",
          "fontCharacter": "\\E7CF"
        }
      },
      "ai-usage-copilot": {
        "description": "Copilot provider icon",
        "default": {
          "fontPath": "./assets/fonts/fa-brands-400.woff2",
          "fontCharacter": "\\E8C7"
        }
      },
      "ai-usage-antigravity": {
        "description": "Antigravity provider icon",
        "default": {
          "fontPath": "./assets/fonts/fa-brands-400.woff2",
          "fontCharacter": "\\F1A0"
        }
      }
    },
    "configuration": {
      "title": "AI Usage Pulse GH 2026",
      "properties": {
        "aiUsageMonitor.enabledProviders": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "claude",
              "codex",
              "copilot",
              "antigravity"
            ]
          },
          "uniqueItems": true,
          "default": [
            "claude",
            "codex",
            "copilot"
          ],
          "description": "Providers to enable in status bar and refresh cycle. Set empty array to disable all providers. Antigravity is opt-in and requires a running agy process."
        },
        "aiUsageMonitor.enableThresholdColors": {
          "type": "boolean",
          "default": true,
          "description": "Enable per-provider warning/critical text badges. For a single enabled provider, a theme-aware threshold color is also applied to the whole status bar item."
        },
        "aiUsageMonitor.copilotLookbackDays": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 365,
          "description": "Copilot usage lookback window in days when estimating token volume and credits. Used when copilotWindowMode is set to lookbackDays."
        },
        "aiUsageMonitor.copilotWindowMode": {
          "type": "string",
          "enum": [
            "lookbackDays",
            "currentMonth"
          ],
          "default": "lookbackDays",
          "description": "Copilot usage period mode: rolling lookbackDays window or current calendar month."
        },
        "aiUsageMonitor.copilotIncludedCredits": {
          "type": "number",
          "default": 1000,
          "minimum": 1,
          "description": "Included Copilot credits used as denominator for the Copilot percentage metric."
        },
        "aiUsageMonitor.copilotAutoModel": {
          "type": "string",
          "default": "gpt-5.3-codex",
          "description": "Model to assume for Copilot records logged as auto when estimating credits."
        },
        "aiUsageMonitor.weeklyExhaustedDisplay": {
          "type": "string",
          "enum": [
            "percent",
            "remainingDays"
          ],
          "default": "percent",
          "description": "When weekly usage is exhausted, show either 100% or days remaining until reset in the status bar."
        },
        "aiUsageMonitor.warningThreshold": {
          "type": "number",
          "default": 70,
          "minimum": 0,
          "maximum": 100,
          "description": "Usage percentage threshold where the status bar shows a warning badge and theme-aware color."
        },
        "aiUsageMonitor.criticalThreshold": {
          "type": "number",
          "default": 85,
          "minimum": 0,
          "maximum": 100,
          "description": "Usage percentage threshold where the status bar shows a critical badge and theme-aware color."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "npm run compile && node --test test/antigravity.test.ts",
    "watch": "tsc -watch -p ./",
    "package:vsix": "npm run compile && npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.79.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "keytar@7.9.0": true,
    "@vscode/vsce-sign@2.1.0": true
  }
}
